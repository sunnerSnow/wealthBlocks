# 全部留空 → 本機示範模式（PGlite 存在 web/.data/pglite，登入改選示範家長）
# 下面三個要「一起」設定才會切到 Supabase；只設一半會直接報錯，避免誤寫到本機資料庫。

# Supabase 專案的 URL 與 publishable key（舊專案可改用 NEXT_PUBLIC_SUPABASE_ANON_KEY）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Postgres 連線字串：用 Supabase「Connect」裡的 Transaction pooler（port 6543）
# 程式只用它來連資料庫；請求內會切換成 authenticated 角色，RLS 照樣生效
DATABASE_URL=

# 簽章「家長模式／孩子模式」cookie 的密鑰，至少 32 個隨機字元；Supabase 模式必填
# 產生方式：node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=

# 選填
# DATABASE_POOL_MAX=5
# PGLITE_DATA_DIR=.data/pglite      # 本機示範資料的位置；memory:// 表示不存檔
# WB_LOCAL_MODE=1                   # 只有本機用 next start 示範時才需要
